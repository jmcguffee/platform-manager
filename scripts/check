#!/usr/bin/env bash
# Everything CI used to run: ShellCheck and the test suite. Run it before you push.
set -euo pipefail
cd "$(dirname "$0")/.."
for tool in shellcheck bats jq yq; do
  command -v "$tool" >/dev/null || { echo "check: $tool is missing (brew install shellcheck bats-core jq yq)" >&2; exit 1; }
done
shellcheck bin/pmgr lib/pmgr/*.sh tests/stubs/fake tests/helpers.bash scripts/check
bats tests/
bin/pmgr version
